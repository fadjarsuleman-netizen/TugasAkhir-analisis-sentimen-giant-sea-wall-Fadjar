sentiment_pipeline = pipeline(
    "sentiment-analysis",
    model="w11wo/indonesian-roberta-base-sentiment-classifier"
)

def chunk_text(text, max_len=512):
    return [text[i:i+max_len] for i in range(0, len(text), max_len)]

def robust_sentiment(text):
    # Ensure the input is treated as a string
    text = str(text)
    chunks = chunk_text(text)
    results = [sentiment_pipeline(chunk)[0] for chunk in chunks]

    # Hitung rata-rata skor untuk label yang paling sering muncul
    labels = [r["label"] for r in results]
    scores = [r["score"] for r in results]
    final_label = max(set(labels), key=labels.count)
    final_score = sum(scores) / len(scores)

    return {"label": final_label, "score": final_score}

from tqdm.auto import tqdm
tqdm.pandas()

results = data["normalisasi"].progress_apply(robust_sentiment)

data["Sentiment Label"] = results.apply(lambda x: x["label"])
data["Sentiment Score"] = results.apply(lambda x: x["score"])
