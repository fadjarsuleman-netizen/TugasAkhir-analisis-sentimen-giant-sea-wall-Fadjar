from sklearn.feature_extraction.text import CountVectorizer
import matplotlib.pyplot as plt
from collections import Counter
import numpy as np

# Daftar stopwords tambahan
custom_stopwords = set([
    'https', 'co', 'rt', '...', 'amp', 'lu', 'deh',
    'ai', 'berapa', 'can','allahuakbar'
])

# Fungsi bersihkan teks dari stopwords manual
def clean_text(text):
    words = text.split()
    words = [w for w in words if w.lower() not in custom_stopwords]
    return " ".join(words)

# Fungsi untuk membuat diagram batang frekuensi n-gram
def plot_ngram_frequencies(texts, ngram_range=(3,3), top_n=15, cmap=plt.cm.Set3):

    # 1️⃣ Bersihkan stopword dari seluruh korpus
    cleaned_texts = [clean_text(t) for t in texts]

    # 2️⃣ Vectorizer tanpa stopword lagi (karena sudah dibersihkan)
    vectorizer = CountVectorizer(ngram_range=ngram_range)
    X = vectorizer.fit_transform(cleaned_texts)

    # 3️⃣ Hitung total frekuensi ngram
    ngram_counts = X.sum(axis=0).A1
    ngram_vocab = vectorizer.get_feature_names_out()
    freq_dist = dict(zip(ngram_vocab, ngram_counts))

    # 4️⃣ Ambil ngram teratas
    top_ngrams = Counter(freq_dist).most_common(top_n)

    if not top_ngrams:
        print("Tidak ada n-gram ditemukan setelah stopword dihapus.")
        return

    labels, values = zip(*top_ngrams)

    # 5️⃣ Warna untuk setiap bar
    colors = cmap(np.linspace(0, 1, len(labels)))

    # 6️⃣ Plot
    plt.figure(figsize=(10, 6))
    bars = plt.barh(labels[::-1], values[::-1], color=colors[::-1])
    plt.title(f"Top {top_n} {ngram_range[0]}-gram Frekuensi", fontsize=14)
    plt.xlabel("Frekuensi")

    # Tambahkan angka
    for bar in bars:
        width = bar.get_width()
        plt.text(width + 0.2, bar.get_y() + bar.get_height()/2,
                 f'{int(width)}', va='center')

    plt.tight_layout()
    plt.show()

# Contoh pemanggilan: Trigram
plot_ngram_frequencies(
    data['normalisasi'],
    ngram_range=(3,3),
    top_n=15,
    cmap=plt.cm.Set3
)
